DATABASE_URL="postgresql://app:app@localhost:5432/wa_booking?schema=public"
JWT_SECRET="change_me"
REDIS_URL="redis://localhost:6379"
WA_WORKER_URL="http://localhost:3100"
SUPERADMIN_USERNAME="admin"
SUPERADMIN_PASSWORD="change_me"

# HTTP port (default 3000)
PORT=3000

# Production: comma-separated allowed browser origins, e.g. https://app.example.com
# Leave empty in local dev to allow any origin.
CORS_ORIGINS=

# OTP delivery (signup)
# OTP_WA_BUSINESS_ID="<business-uuid-with-connected-wa>"  # demo-salon id from seed log
# RESEND_API_KEY=""
# OTP_EMAIL_FROM="BookNow <onboarding@yourdomain.com>"
# OTP_ALLOW_DEV_BYPASS=true  # default: accept code 1234 + show code when delivery fails

